    },
    "channelId": "1075696533699317810",
    "channelName": "「🚪」𝐇𝐞́𝐦𝐢𝐜𝐲𝐜𝐥𝐞",
    "content": "Déclaration sur l'Ukraine",
    "timestamp": 1756482901652,
    "attachments": [],
    "embeds": [],
    "mentions": {
